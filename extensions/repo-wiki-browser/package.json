{
  "name": "repo-wiki-browser",
  "displayName": "Repo Wiki Browser",
  "description": "Browse repo-agent wiki outputs; Update Wiki runs a configurable terminal command (default: uv run repo-wiki generate). Does not bundle the Python repo-wiki CLI — uv and repo-wiki must be available in the integrated terminal environment.",
  "version": "0.1.0",
  "publisher": "repo-agent",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bingooyong/repo-wiki-agent"
  },
  "activationEvents": [
    "onView:repoWikiBrowser.sidebar",
    "onCommand:repoWikiBrowser.openViewer",
    "onCommand:repoWikiBrowser.refreshTree",
    "onCommand:repoWikiBrowser.runVerify",
    "onCommand:repoWikiBrowser.updateWiki",
    "onCommand:repoWikiBrowser.syncWiki",
    "onCommand:repoWikiBrowser.openPage",
    "onCommand:repoWikiBrowser.openSourceCitation",
    "onCommand:repoWikiBrowser.configureLlm",
    "onCommand:repoWikiBrowser.setApiKey",
    "onCommand:repoWikiBrowser.clearApiKey",
    "onCommand:repoWikiBrowser.testLlmConfig"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Browsing published Wiki files remains available. Commands, configuration tests, and API key injection require a trusted workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "repoWikiBrowser.openViewer",
        "title": "Open Wiki Viewer",
        "category": "Repo Wiki"
      },
      {
        "command": "repoWikiBrowser.refreshTree",
        "title": "Refresh Wiki Tree",
        "category": "Repo Wiki"
      },
      {
        "command": "repoWikiBrowser.runVerify",
        "title": "Run Verification (--ci)",
        "category": "Repo Wiki"
      },
      {
        "command": "repoWikiBrowser.updateWiki",
        "title": "Update Wiki",
        "category": "Repo Wiki"
      },
      {
        "command": "repoWikiBrowser.syncWiki",
        "title": "Sync Wiki",
        "category": "Repo Wiki"
      },
      {
        "command": "repoWikiBrowser.openSourceCitation",
        "title": "Open Source Citation",
        "category": "Repo Wiki"
      },
      {
        "command": "repoWikiBrowser.configureLlm",
        "title": "Configure LLM Settings",
        "category": "Repo Wiki"
      },
      {
        "command": "repoWikiBrowser.setApiKey",
        "title": "Set LLM API Key",
        "category": "Repo Wiki"
      },
      {
        "command": "repoWikiBrowser.clearApiKey",
        "title": "Clear LLM API Key",
        "category": "Repo Wiki"
      },
      {
        "command": "repoWikiBrowser.testLlmConfig",
        "title": "Test LLM Configuration",
        "category": "Repo Wiki"
      }
    ],
    "views": {
      "repo-wiki-browser": [
        {
          "type": "webview",
          "id": "repoWikiBrowser.sidebar",
          "name": "REPO WIKI",
          "visibility": "visible"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repo-wiki-browser",
          "title": "Repo Wiki",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Repo Wiki",
      "properties": {
        "repoWikiBrowser.generateCommand": {
          "type": "string",
          "default": "uv run repo-wiki generate --profile qoder-like",
          "description": "Shell command sent to the integrated terminal for Update Wiki. Default expects `uv` on PATH and a workspace where `repo-wiki` resolves (e.g. via project pyproject). Override if you use pipx, conda, or `python -m repo_wiki`. The extension does not embed the Python CLI."
        },
        "repoWikiBrowser.llm.source": {
          "type": "string",
          "enum": [
            "extension",
            "yaml",
            "environment"
          ],
          "default": "extension",
          "description": "LLM configuration source for extension-launched commands: extension injects only non-empty visual settings, yaml preserves repo-wiki.yaml non-secret fields and may inject a stored key, environment injects no LLM overrides."
        },
        "repoWikiBrowser.llm.provider": {
          "type": "string",
          "default": "",
          "description": "Optional LLM provider injected as LLM_PROVIDER only when repoWikiBrowser.llm.source is extension and this value is non-empty. Empty preserves YAML/shell/CLI defaults."
        },
        "repoWikiBrowser.llm.model": {
          "type": "string",
          "default": "",
          "description": "Optional LLM model injected as LLM_MODEL only when repoWikiBrowser.llm.source is extension and this value is non-empty. Empty preserves YAML/shell/CLI defaults."
        },
        "repoWikiBrowser.llm.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional base URL injected as LLM_BASE_URL only when repoWikiBrowser.llm.source is extension and this value is non-empty."
        },
        "repoWikiBrowser.llm.apiKeyEnv": {
          "type": "string",
          "default": "REPO_WIKI_LLM_API_KEY",
          "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Environment variable name that repo-wiki CLI should read for the API key. Empty uses REPO_WIKI_LLM_API_KEY. The actual key is stored only in VS Code SecretStorage."
        }
      }
    }
  },
  "dependencies": {
    "js-yaml": "^4.3.1",
    "mocha": "^11.7.5"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --check ./out/extension.js"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "diff": ">=5.2.0",
    "brace-expansion": ">=2.1.4"
  }
}
